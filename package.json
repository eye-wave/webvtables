{
  "name": "webvtabes",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "codegen": "bun run --sequential 'codegen:*'",
    "codegen:nodes": "cargo test --lib --target \"$(rustc -vV | sed -n 's/host: //p')\" generate_ts",
    "codegen:exports": "bun run scripts/exports.mjs"
  },
  "devDependencies": {
    "@types/audioworklet": "^0.0.100",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-glsl": "^1.6.2",
    "vite-plugin-html": "^3.2.2",
    "vite-plugin-solid": "^2.11.14"
  },
  "dependencies": {
    "fflate": "^0.8.3",
    "lite-fps-meter": "^1.3.0",
    "lucide-solid": "^1.54.0",
    "solid-js": "^1.9.17"
  }
}
